! Stage 2: phase-resolved Gaia photometry used by the fitter.
!
! This is the file inlist_rsp_RR_Lyrae_colors reads. The separate
! history_columns.list in this directory carries similar content but is not
! referenced by any stage -- stage 1 and the LINA screen both read
! history_columns_settle.list. Treat history_columns.list as dead.
!
! DO NOT list the Colors output columns here. When use_colors = .true. MESA
! appends Mag_bol, Flux_bol, Interp_rad, Gbp, G and Grp itself, and listing
! them explicitly makes star_set_history_columns fail at startup with
! "bad history list name". Verified 2026-08-14 against MESA 58a8a84.

include ''

      model_number
      star_age
      star_age_day
      log_dt_sec
      log_L
      log_Teff
      log_g
      photosphere_r
      effective_T
      star_mass
      phase_of_evolution
      rsp_phase
      rsp_period_in_days
      rsp_num_periods
      rsp_DeltaMag
      rsp_DeltaR
      rsp_GREKM
      rel_E_err
      log_rel_run_E_err
      max_abs_v_div_cs
      v_surf_km_s
