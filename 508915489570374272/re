#!/usr/bin/env bash
set -euo pipefail

: "${MESA_DIR:?MESA_DIR must be set}"
MESA_DIR="$(cd "$MESA_DIR" && pwd -P)"
export MESA_DIR

if [[ ! -r "${MESA_DIR}/star/work/Makefile" ]]; then
    echo "ERROR: invalid MESA_DIR=$MESA_DIR" >&2
    exit 2
fi

photo_directory=photos

most_recent_photo() {
    ls -tp "$photo_directory" | grep -v / | head -1
}

if [[ $# -eq 0 ]]; then
    photo=$(most_recent_photo)
else
    photo=$1
fi

if [[ -z "${photo:-}" || ! -f "$photo_directory/$photo" ]]; then
    echo "specified photo ($photo_directory/$photo) does not exist"
    exit 1
fi

echo "restart from $photo_directory/$photo"
cp "$photo_directory/$photo" restart_photo

date "+DATE: %Y-%m-%d%nTIME: %H:%M:%S"
make -f Makefile run
date "+DATE: %Y-%m-%d%nTIME: %H:%M:%S"
