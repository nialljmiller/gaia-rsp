! LINA-only RSP evaluation for the automated Gaia fitter.
! fit_gaia_rsp.py patches the RSP parameters before each evaluation.

&star_job
      show_log_description_at_start = .false.
      create_RSP_model = .true.
      load_saved_model = .false.
      save_model_when_terminate = .false.
      history_columns_file = 'history_columns_settle.list'
      profile_columns_file = 'profile_columns.list'
      initial_zfracs = 6
      set_initial_age = .true.
      initial_age = 0
      set_initial_model_number = .true.
      initial_model_number = 0
      set_initial_cumulative_energy_error = .true.
      new_cumulative_energy_error = 0d0
/

&eos
/

&kap
      Zbase = 0.024100d0
      kap_file_prefix = 'a09'
      kap_lowT_prefix = 'lowT_fa05_a09p'
      kap_CO_prefix = 'a09_co'
/

&controls
      max_model_number = 1
      use_gold2_tolerances = .true.

      RSP_mass = 8.000000d0
      RSP_Teff = 5400.000000d0
      RSP_L = 6535.298257d0
      RSP_X = 0.700000d0
      RSP_Z = 0.024100d0

      x_integer_ctrl(1) = 3
      x_integer_ctrl(6) = 0
      x_ctrl(3) = 0d0

      ! Timestep controls are inert here: max_model_number = 1 means no nonlinear
      ! step is ever taken. Kept consistent with stage 1 for clarity only.
      ! Envelope construction. The builder integrates inward to RSP_T_anchor and
      ! adjusts the outer zone mass until the anchor temperature is matched. At
      ! L = 6530, Teff = 5400 the default tolerance could not be satisfied:
      !   "failed to find outer dm to satisfy tolerance for T_anchor"
      ! Loosening it costs nothing physically -- it only sets how precisely the
      ! anchor zone is placed during setup, not the structure that is evolved.
      RSP_T_anchor_tolerance = 1d-6
      RSP_max_outer_dm_tries = 400

      RSP_target_steps_per_cycle = 600
      RSP_alfa = 1.5d0
      RSP_alfam = 0.25d0

      ! Convection set parameters, managed by configure_target.py.
      ! Placeholders; overwritten. Do not delete these lines.
      RSP_gammar = 0d0
      RSP_alfap = 0d0
      RSP_alfat = 0d0
      RSP_kick_vsurf_km_per_sec = 20d0

      history_interval = 1000000
      photo_interval = 1000000
      profile_interval = 1000000
      terminal_interval = 1000000
      terminal_show_age_units = 'days'
      terminal_show_timestep_units = 'secs'
      terminal_show_log_dt = .false.
      terminal_show_log_age = .false.
/

&colors
      use_colors = .false.
      make_csv = .false.
      sed_per_model = .false.
/

&pgstar
/
